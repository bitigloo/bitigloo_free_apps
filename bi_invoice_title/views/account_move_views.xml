<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_view_inherit" model="ir.ui.view">
        <field name="name">account_move_form_inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="payment_reference" position="after">
                <field name="invoice_title" readonly="state != 'draft'"/>
            </field>
            <xpath expr="//group[hasclass('oe_invoice_lines_tab')]" position="inside">
                <field name="invoice_note" placeholder="Invoice Notes" nolabel="1"/>
            </xpath>
        </field>
    </record>
</odoo>
