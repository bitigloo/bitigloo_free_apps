<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_invoice_title" model="ir.ui.view">
        <field name="name">res.config.settings.view.invoice.title</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="55"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="printing_invoice_title" string="Print Invoice Title" help="Define the position (according Name) where you want to print invoice title.">
                    <field name="invoice_title_position_selection" widget="radio"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>