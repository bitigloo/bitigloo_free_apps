<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_view_inherit" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-if="o.company_id.external_report_layout_id.xml_id != 'l10n_din5008.external_layout_din5008'">

                <t t-set="layout_document_title">
                    <t t-if="o._get_invoice_title() == 'before'">
                        <small>
                            <span t-field="o.invoice_title"/>
                        </small>
                    </t>
                    <span><h1></h1></span>
                    <span t-if="not proforma"/>
                    <span t-else="">PROFORMA</span>
                    <t t-if="o._get_invoice_title() == 'replace' and o.move_type == 'out_invoice' and o.invoice_title">
                        <t t-set="invoice_title" t-value="o.invoice_title.name"/>
                    </t>
                    <t t-else="">
                        <t t-set="invoice_title" t-value="'Invoice'"/>
                    </t>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'"><t t-esc="invoice_title"/></span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Draft <t t-esc="invoice_title"/></span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled <t t-esc="invoice_title"/></span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">Credit Note</span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">Draft Credit Note</span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">Cancelled Credit Note</span>
                    <span t-elif="o.move_type == 'in_refund'">Vendor Credit Note</span>
                    <span t-elif="o.move_type == 'in_invoice'">Vendor Bill</span>
                    <span t-if="o.name != '/'" t-field="o.name">INV/2023/0001</span>
                </t>
                <t t-if="o._get_invoice_title() == 'after'">
                    <small>
                        <span t-field="o.invoice_title"/>
                    </small>
                </t>
            </t>
        </xpath>
        <xpath expr="//div[@id='payment_term']" position="after">
            <t t-if="o.company_id.external_report_layout_id.xml_id != 'l10n_din5008.external_layout_din5008'">
                <div t-field="o.invoice_note" name="invoice_note"/>
            </t>
            <t t-else="">
                <div style="margin-left: 21px;" t-field="o.invoice_note" name="invoice_note"/>
            </t>

        </xpath>
    </template>

    <template id="report_external_layout_din5008_view_inherit" inherit_id="l10n_din5008.external_layout_din5008">
        <xpath expr="//h2" position="replace">
            <t t-if="o and o._name == 'account.move'">
                <t t-if="o and o._name == 'account.move' and o._get_invoice_title() == 'before' and o.invoice_title">
                    <small style="margin-left: 21px; margin-top: 16px; position: fixed;">
                        <span t-field="o.invoice_title"/>
                    </small>
                </t>

                <h2>
                    <span t-if="not o and not docs">Invoice</span>
                    <span t-else="">
                        <t t-set="o" t-value="docs[0]" t-if="not o"/>
                        <t t-if="o._get_invoice_title() == 'replace' and o.invoice_title">
                            <span t-field="o.invoice_title"/>
                        </t>
                        <t t-if="din5008_document_title">
                                <t t-out="din5008_document_title"/>
                            </t>
                        <span t-elif="'name' in o" t-field="o.name"/>
                    </span>
                </h2>

                <t t-if="o and o._name == 'account.move' and o._get_invoice_title() == 'after' and o.invoice_title">
                    <small style="margin-left: 21px;">
                        <span t-field="o.invoice_title"/>
                    </small>
                </t>
            </t>
        </xpath>
    </template>
</odoo>