<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Account Move Tag Form View -->
    <record id="account_move_tag_form_view" model="ir.ui.view">
    <field name="name">account.move.tag.form</field>
    <field name="model">account.move.tag</field>
    <field name="arch" type="xml">
        <form string="Journal Entry Tag">
          <sheet>
            <group>
              <group>
                <field name="name"/>
              </group>
              <group>
                <field name="sequence"/>
                <field name="color" widget="color_picker"/>
              </group>
            </group>
          </sheet>
        </form>
    </field>
    </record>
    <!-- Account Move Tag List View -->
    <record id="account_move_tag_list_view" model="ir.ui.view">
        <field name="name">account.move.tag.list</field>
        <field name="model">account.move.tag</field>
        <field name="arch" type="xml">
            <tree string="Journal Entry Tags" default_order="sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>
    <!-- Window Action -->
    <record model="ir.actions.act_window" id="action_account_move_tag">
        <field name="name">Journal Entry Tags</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.move.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Journal Entry Tags
          </p><p>
            Add a tag to be used on the entries.
          </p>
        </field>
    </record>
    <!-- Menu -->
    <menuitem
        id="menu_account_move_tag_title"
        name="Tags"
        parent="account.menu_finance_configuration"
        groups="account.group_account_manager"
        sequence="99"/>
    <menuitem
        id="menu_account_move_tag"
        name="Journal Entry Tags"
        parent="bi_account_move_tag.menu_account_move_tag_title"
        action="action_account_move_tag"
        groups="account.group_account_manager"/>
</odoo>
